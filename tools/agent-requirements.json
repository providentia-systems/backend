{
  "schemaVersion": 1,
  "repositoryRole": "backend",
  "runtime": {
    "php": "8.5.9",
    "composer": "2.10.2",
    "gdWebp": "bundled-php-8.5.9",
    "redisExtension": "6.3.0",
    "xdebug": "3.5.3",
    "node": "22.14.0",
    "nodeMinimum": "18.19.0"
  },
  "nodeDownloads": {
    "linux": {
      "x64": {
        "url": "https://nodejs.org/download/release/v22.14.0/node-v22.14.0-linux-x64.tar.xz",
        "sha256": "69b09dba5c8dcb05c4e4273a4340db1005abeafe3927efda2bc5b249e80437ec"
      },
      "arm64": {
        "url": "https://nodejs.org/download/release/v22.14.0/node-v22.14.0-linux-arm64.tar.xz",
        "sha256": "08bfbf538bad0e8cbb0269f0173cca28d705874a67a22f60b57d99dc99e30050"
      }
    }
  },
  "linux": {
    "aptPackages": [
      "ca-certificates",
      "curl",
      "docker-compose-v2",
      "docker.io",
      "git",
      "jq",
      "nodejs",
      "openssl",
      "ripgrep",
      "xz-utils",
      "unzip",
      "zip"
    ]
  },
  "containerImages": [
    "php:8.5.9-cli-alpine3.23",
    "php:8.5.9-fpm-alpine3.23",
    "composer:2.10.2",
    "mysql:8.4.6",
    "mariadb:11.8.3",
    "redis:8.2.1-alpine",
    "valkey/valkey:8.1.3-alpine"
  ],
  "networkAllowlist": [
    "archive.ubuntu.com",
    "security.ubuntu.com",
    "github.com",
    "api.github.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "nodejs.org",
    "repo.packagist.org",
    "packagist.org",
    "pecl.php.net",
    "registry-1.docker.io",
    "auth.docker.io",
    "production.cloudflare.docker.com",
    "ghcr.io",
    "proxy.golang.org",
    "sum.golang.org"
  ],
  "validation": [
    "bash tests/structural/verify.sh",
    "composer install --no-interaction --prefer-dist --no-progress",
    "composer check",
    "composer test:coverage && composer coverage:check",
    "composer test:mutation",
    "composer audit --locked",
    "bash tools/agent-setup.sh --matrix",
    "docker compose --profile sqlite --profile mysql --profile mariadb --profile redis --profile valkey config --quiet",
    "docker build --file Dockerfile.production --target runtime .",
    "docker build --file Dockerfile.production --target media-worker .",
    "docker build --file Dockerfile.production --target web ."
  ]
}

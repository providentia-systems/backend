{
  "schemaVersion": 1,
  "repositoryRole": "backend",
  "runtime": {
    "php": "8.5.9",
    "composer": "2.10.2",
    "composerPharSha256": "5ee7125f8a30a34d246cefdc0bc85b8a783b28f2aec968994118512350d28027",
    "redisExtension": "6.3.0",
    "xdebug": "3.5.3",
    "nodeMinimum": "18.19.0"
  },
  "linux": {
    "aptPackages": [
      "ca-certificates",
      "curl",
      "docker-compose-v2",
      "docker.io",
      "git",
      "jq",
      "nodejs",
      "openssl",
      "ripgrep",
      "unzip",
      "zip"
    ]
  },
  "containerImages": [
    "php:8.5.9-cli-alpine3.23",
    "php:8.5.9-fpm-alpine3.23",
    "composer:2.10.2",
    "mysql:8.4.6",
    "mariadb:11.8.3",
    "redis:8.2.1-alpine",
    "valkey/valkey:8.1.3-alpine"
  ],
  "networkAllowlist": [
    "archive.ubuntu.com",
    "security.ubuntu.com",
    "github.com",
    "api.github.com",
    "objects.githubusercontent.com",
    "codeload.github.com",
    "repo.packagist.org",
    "packagist.org",
    "pecl.php.net",
    "registry-1.docker.io",
    "auth.docker.io",
    "production.cloudflare.docker.com",
    "ghcr.io",
    "proxy.golang.org",
    "sum.golang.org"
  ],
  "validation": [
    "bash tests/structural/verify.sh",
    "composer install --no-interaction --prefer-dist --no-progress",
    "composer check",
    "composer test:coverage && composer coverage:check",
    "composer test:mutation",
    "composer audit --locked",
    "docker compose --profile sqlite --profile mysql --profile mariadb --profile redis --profile valkey config --quiet",
    "docker build --file Dockerfile.production --target runtime .",
    "docker build --file Dockerfile.production --target media-worker .",
    "docker build --file Dockerfile.production --target web ."
  ]
}

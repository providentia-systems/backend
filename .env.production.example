# Providentia proprietary deployment example. Copy to a protected secret
# mechanism; never commit populated production values.
APP_ENV=production
APP_VERSION=1.2.0
APP_DEBUG=0
DATABASE_URL=mysql://providentia:CHANGE_ME@mysql.internal:3306/providentia?charset=utf8mb4
QUEUE_DSN=redis+phpredis://:CHANGE_ME@redis.internal:6379
QUEUE_NAME=providentia.default
QUEUE_REQUIRED=1
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
AUTH_TOKEN_PEPPER=CHANGE_TO_AT_LEAST_32_RANDOM_BYTES
SYNC_CURSOR_SECRET=CHANGE_TO_AN_INDEPENDENT_32_BYTE_SECRET
SYNC_CURSOR_TTL_SECONDS=2592000
EXPOSE_DEVELOPMENT_TOKENS=0
MAIL_DSN=smtps://smtp-user:CHANGE_ME@smtp.example.net:465
MAIL_FROM=no-reply@example.net
PUBLIC_BASE_URL=https://app.example.net
CORS_ALLOWED_ORIGINS=https://app.example.net
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
AI_SERVER_PROXY_ENABLED=0
AI_CREDENTIAL_KEK=
AI_CREDENTIAL_KEY_VERSION=1
AI_COMPATIBLE_ENDPOINT=
AI_OLLAMA_ENDPOINT=
AI_ALLOW_PRIVATE_ENDPOINTS=0
AI_MAX_IMAGE_BYTES=8388608

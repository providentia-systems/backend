# Production configuration reference. scripts/setup-production.sh --prepare-only
# creates independent secrets and selects one SQL engine. Never commit populated
# values. Prefer the three immutable digests in a release's images.env.
# See docs/deployment/production.md for every setting and the deployment sequence.
APP_ENV=production
APP_VERSION=1.2.0
APP_DEBUG=0
PROVIDENTIA_IMAGE=ghcr.io/providentia-systems/backend:1.2.0
PROVIDENTIA_WEB_IMAGE=ghcr.io/providentia-systems/backend-web:1.2.0
PROVIDENTIA_MEDIA_IMAGE=ghcr.io/providentia-systems/backend-media-worker:1.2.0
# Helper metadata: choose mysql OR mariadb OR external, plus local Redis or an
# external QUEUE_DSN. COMPOSE_PROFILES is derived by setup-production.sh.
# The production runtime, PDO driver, migrations, and CI support MySQL 8.4 and
# MariaDB 11.8. PostgreSQL is not a supported production database.
# Internal retry marker managed by setup-production.sh; do not reset it.
PROVIDENTIA_SETUP_STARTED=0
PROVIDENTIA_DATABASE=mysql
PROVIDENTIA_MANAGED_REDIS=1
COMPOSE_PROFILES=mysql,redis
# Empty = Docker named volumes. Set before initial deployment for host binds.
PROVIDENTIA_DATA_DIRECTORY=
PROVIDENTIA_FPM_UPSTREAM=api:9000
PROVIDENTIA_BIND_ADDRESS=127.0.0.1
PROVIDENTIA_HTTP_PORT=8080
PROVIDENTIA_TRUSTED_PROXY_CIDRS=192.0.2.10/32
PROVIDENTIA_METRICS_TOKEN=CHANGE_TO_AN_INDEPENDENT_32_BYTE_SECRET
DATABASE_URL=mysql://providentia:CHANGE_ME@mysql.internal:3306/providentia?charset=utf8mb4
QUEUE_DSN=redis+phpredis://:CHANGE_ME@redis.internal:6379
QUEUE_NAME=providentia.default
QUEUE_REQUIRED=1
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# 0 keeps trusted installations signed in until explicit sign-out, device or
# session revocation, account disablement, or a security invalidation. Set a
# positive number of seconds only as a deliberate finite inactivity ceiling.
AUTH_WEB_IDLE_TTL_SECONDS=0
AUTH_NATIVE_IDLE_TTL_SECONDS=0
AUTH_RATE_LIMIT_RETENTION_DAYS=2
AUTH_TOKEN_PEPPER=CHANGE_TO_AT_LEAST_32_RANDOM_BYTES
AUTH_COOKIE_SECURE=1
NOTIFICATION_PAYLOAD_KEK=CHANGE_TO_BASE64_ENCODED_32_BYTE_KEY
NOTIFICATION_KEY_VERSION=1
NOTIFICATION_BATCH_SIZE=100
NOTIFICATION_MAX_ATTEMPTS=10
SYNC_CURSOR_SECRET=CHANGE_TO_AN_INDEPENDENT_32_BYTE_SECRET
SYNC_CURSOR_TTL_SECONDS=2592000
SYNC_OFFLINE_WINDOW_DAYS=90
SYNC_TOMBSTONE_RETENTION_DAYS=120
MAIL_DSN=smtps://smtp-user:CHANGE_ME@smtp.example.net:465
MAIL_FROM=no-reply@example.net
# Stable HTTPS API origin compiled into the native client/admin builds.
PUBLIC_BASE_URL=https://api.example.net
# Comma-separated exact HTTPS browser origins. No wildcard, credentials, path,
# query, or fragment. Native Android/iOS/desktop clients do not use CORS.
CORS_ALLOWED_ORIGINS=https://api.example.net
OUTBOX_POLL_SECONDS=2
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
AI_SERVER_PROXY_ENABLED=0
AI_CREDENTIAL_KEK=
AI_CREDENTIAL_KEY_VERSION=1
AI_ORCHESTRATION_MAX_ATTEMPTS=8
AI_COMPATIBLE_ENDPOINT=
AI_OLLAMA_ENDPOINT=
AI_ALLOW_PRIVATE_ENDPOINTS=0
# Deliberately separate LAN policy for person/home-owned profile endpoints:
# 1 lets an Ollama profile endpoint use plain HTTP and private/loopback hosts.
# Every other profile endpoint stays HTTPS with a public host.
AI_ALLOW_PRIVATE_NETWORK_ENDPOINTS=0
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_IMAGES=8
AI_MEDIA_ROOT=var/private-media
AI_MEDIA_KEK=CHANGE_TO_32_RANDOM_BYTES_BASE64
CATALOG_IMAGE_KEK=CHANGE_TO_AN_INDEPENDENT_32_BYTE_SECRET_BASE64
CATALOG_IMAGE_KEY_VERSION=1
CATALOG_IMAGE_PREVIOUS_KEYS_JSON=[]
AI_MEDIA_KEY_VERSION=1
AI_MEDIA_DEFAULT_QUOTA_BYTES=2147483648
AI_MEDIA_TRANSIENT_TTL_SECONDS=86400
AI_MEDIA_MAX_EXPORT_BYTES=67108864
AI_MAX_VIDEO_BYTES=134217728
AI_MAX_VIDEO_DURATION_SECONDS=300
AI_MAX_VIDEO_FRAMES=12
AI_VIDEO_PROCESS_TIMEOUT_SECONDS=180
# Per media worker: must fit the source video plus extracted frames.
AI_VIDEO_TMPFS_SIZE=512m
AI_FFPROBE_BINARY=/usr/bin/ffprobe
AI_FFMPEG_BINARY=/usr/bin/ffmpeg
BILLING_ENABLED=0
BILLING_ALLOW_PRIVATE_ENDPOINTS=0
BILLING_HTTP_TIMEOUT_SECONDS=10
BILLING_MAXIMUM_RESPONSE_BYTES=1048576
PAYPAL_ENABLED=0
PAYPAL_ENVIRONMENT=live
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
HOSTED_CARD_ENABLED=0
HOSTED_CARD_API_BASE=https://payments.example.net
HOSTED_CARD_CHECKOUT_PATH=/v1/checkout/sessions
HOSTED_CARD_REDIRECT_HOSTS=secure-payments.example.net
HOSTED_CARD_API_KEY=
HOSTED_CARD_WEBHOOK_SECRET=
HOSTED_CARD_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
HOSTED_CARD_WEBHOOK_TIMESTAMP_HEADER=X-Webhook-Timestamp
HOSTED_CARD_WEBHOOK_TOLERANCE_SECONDS=300
DATA_EXPORT_KEK=CHANGE_TO_32_RANDOM_BYTES_BASE64
DATA_EXPORT_ROOT=var/data-exports
DATA_EXPORT_PAGE_SIZE=250
# Optional local SQL profiles. Only the selected engine needs credentials.
MYSQL_DATABASE=providentia
MYSQL_USER=providentia
MYSQL_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_ROOT
MARIADB_DATABASE=providentia
MARIADB_USER=providentia
MARIADB_PASSWORD=CHANGE_ME
MARIADB_ROOT_PASSWORD=CHANGE_ME_ROOT
REDIS_PASSWORD=CHANGE_ME
# Optional backup profile; provide these only when running restic backup.
RESTIC_REPOSITORY=s3:s3.example.net/providentia
RESTIC_PASSWORD_FILE=/run/secrets/providentia-restic-password
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
BACKUP_STAGING_DIRECTORY=/srv/providentia/backup-staging
BACKUP_HOST=providentia-production

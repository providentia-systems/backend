<!doctype html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="color-scheme" content="light">
    <title>Review Providentia login</title>
    <link rel="stylesheet" href="/assets/providentia-v1.css">
</head>
<body>
<main class="hero">
    <section class="panel" aria-labelledby="login-title">
        <p class="eyebrow">Login link</p>
        <h1 id="login-title">Approve this login?</h1>
        <p><strong><?= htmlspecialchars((string) $deviceName, ENT_QUOTES, 'UTF-8') ?></strong></p>
        <p>Platform: <?= htmlspecialchars((string) $platform, ENT_QUOTES, 'UTF-8') ?></p>
        <p>Requested: <?= htmlspecialchars((string) $createdAt, ENT_QUOTES, 'UTF-8') ?></p>
        <p>Approval expires: <?= htmlspecialchars((string) $expiresAt, ENT_QUOTES, 'UTF-8') ?></p>
        <form method="post" action="/login-links/<?= rawurlencode((string) $requestId) ?>/approve">
            <input type="hidden" name="csrf" value="<?= htmlspecialchars((string) $csrf, ENT_QUOTES, 'UTF-8') ?>">
            <button class="button" type="submit">Approve login</button>
        </form>
        <form method="post" action="/login-links/<?= rawurlencode((string) $requestId) ?>/deny">
            <input type="hidden" name="csrf" value="<?= htmlspecialchars((string) $csrf, ENT_QUOTES, 'UTF-8') ?>">
            <button type="submit">Deny</button>
        </form>
        <p>This browser will not be signed in. Only the client that requested the link can finish login.</p>
    </section>
</main>
</body>
</html>

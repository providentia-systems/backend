<?xml version="1.0"?>
<ruleset name="Providentia">
    <description>Providentia PHP coding standard.</description>
    <file>src</file>
    <file>config</file>
    <file>migrations</file>
    <file>tests</file>
    <exclude-pattern>vendor/*</exclude-pattern>
    <arg name="colors"/>

# syntax=docker/dockerfile:1.10

ARG PHP_IMAGE=php:8.5.9-fpm-alpine3.23
ARG COMPOSER_IMAGE=composer:2.10.2
ARG GO_IMAGE=golang:1.26.6-alpine3.23
ARG ALPINE_IMAGE=alpine:3.23

FROM ${COMPOSER_IMAGE} AS composer-bin

FROM ${GO_IMAGE} AS web-builder
ARG CADDY_VERSION=2.11.4
ARG GO_CRYPTO_VERSION=0.55.0
ARG GO_TEXT_VERSION=0.39.0
ARG GO_GRPC_VERSION=1.83.1
ENV CGO_ENABLED=0 \
    GOPROXY=https://proxy.golang.org,direct \
    GOSUMDB=sum.golang.org \
    GOTOOLCHAIN=local
WORKDIR /build
RUN apk add --no-cache ca-certificates git \
    && go mod init providentia.local/caddy-build \
    && go get github.com/caddyserver/caddy/v2/cmd/caddy@v${CADDY_VERSION} \
    && go get golang.org/x/crypto@v${GO_CRYPTO_VERSION} \
        golang.org/x/text@v${GO_TEXT_VERSION} \
        google.golang.org/grpc@v${GO_GRPC_VERSION} \
    && go build -trimpath -ldflags="-s -w" \
        -o /usr/local/bin/caddy github.com/caddyserver/caddy/v2/cmd/caddy

FROM ${PHP_IMAGE} AS php-base
RUN apk upgrade --no-cache \
    && apk add --no-cache icu-libs libjpeg-turbo libpng libwebp libzip oniguruma sqlite-libs \
    && apk add --no-cache --virtual .build-deps \
        ${PHPIZE_DEPS} icu-dev libjpeg-turbo-dev libpng-dev libwebp-dev libzip-dev oniguruma-dev sqlite-dev \
    && docker-php-ext-configure gd --with-jpeg --with-webp \
    && docker-php-ext-install -j"$(nproc)" gd intl mbstring pdo_mysql pdo_sqlite \
    && pecl install redis-6.3.0 \
    && docker-php-ext-enable redis \
    && apk del .build-deps

FROM php-base AS dependencies
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY . .
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --classmap-authoritative \
    --no-scripts

FROM php-base AS runtime
ARG APP_VERSION=development
ARG VCS_REF=unknown
ARG VCS_URL=https://github.com/providentia-systems/backend
LABEL org.opencontainers.image.title="Providentia backend" \
      org.opencontainers.image.source="${VCS_URL}" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"
WORKDIR /app
COPY --from=dependencies /app /app
COPY infrastructure/php/request-limits.ini /usr/local/etc/php/conf.d/zz-providentia-request-limits.ini
COPY infrastructure/php/production.ini /usr/local/etc/php/conf.d/zz-providentia-production.ini
RUN chmod +x bin/doctrine-migrations bin/providentia tool/*.sh \
    && mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

USER www-data
EXPOSE 9000
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["php", "-r", "exit(is_readable('/proc/1/status') ? 0 : 1);"]
CMD ["php-fpm", "-F"]

FROM runtime AS cli
CMD ["php", "bin/providentia", "list"]

FROM runtime AS media-worker
USER root
RUN apk add --no-cache ffmpeg
USER www-data
CMD ["php", "bin/providentia", "ai:video:process"]

FROM ${ALPINE_IMAGE} AS web
RUN apk upgrade --no-cache \
    && apk add --no-cache ca-certificates \
    && addgroup -S caddy \
    && adduser -S -D -H -G caddy caddy \
    && mkdir -p /data /config \
    && chown -R caddy:caddy /data /config
COPY --from=web-builder /usr/local/bin/caddy /usr/bin/caddy
COPY infrastructure/caddy/Caddyfile.production /etc/caddy/Caddyfile
COPY public /srv/public
USER caddy
EXPOSE 8080 9090
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD ["wget", "-q", "--spider", "http://127.0.0.1:8080/health/live"]
CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]

# syntax=docker/dockerfile:1.10

FROM composer:2.10.2 AS dependencies
WORKDIR /app
COPY composer.json composer.lock ./
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --classmap-authoritative \
    --no-scripts

FROM php:8.5.8-fpm-alpine3.22 AS runtime
RUN apk add --no-cache icu-libs libzip oniguruma sqlite-libs \
    && apk add --no-cache --virtual .build-deps \
        ${PHPIZE_DEPS} icu-dev libzip-dev oniguruma-dev sqlite-dev \
    && docker-php-ext-install -j"$(nproc)" intl mbstring opcache pdo_mysql pdo_sqlite \
    && pecl install redis-6.2.0 \
    && docker-php-ext-enable redis \
    && apk del .build-deps

WORKDIR /app
COPY --from=dependencies /app/vendor ./vendor
COPY . .
COPY infrastructure/php/production.ini /usr/local/etc/php/conf.d/zz-providentia-production.ini

RUN chmod +x bin/doctrine-migrations bin/providentia tool/*.sh \
    && mkdir -p var/cache var/log \
    && chown -R www-data:www-data var \
    && composer dump-autoload --no-dev --classmap-authoritative --no-interaction

USER www-data
EXPOSE 9000
CMD ["php-fpm", "-F"]

FROM runtime AS cli
CMD ["php", "bin/providentia", "list"]

# syntax=docker/dockerfile:1.10

ARG PHP_IMAGE=php:8.5.9-fpm-alpine3.23
ARG COMPOSER_IMAGE=composer:2.10.2
ARG CADDY_IMAGE=caddy:2.10.2-alpine

FROM ${COMPOSER_IMAGE} AS composer-bin

FROM ${PHP_IMAGE} AS php-base
RUN apk add --no-cache icu-libs libzip oniguruma sqlite-libs \
    && apk add --no-cache --virtual .build-deps \
        ${PHPIZE_DEPS} icu-dev libzip-dev oniguruma-dev sqlite-dev \
    && docker-php-ext-install -j"$(nproc)" intl mbstring pdo_mysql pdo_sqlite \
    && docker-php-ext-install -j1 opcache \
    && pecl install redis-6.2.0 \
    && docker-php-ext-enable redis \
    && apk del .build-deps

FROM php-base AS dependencies
COPY --from=composer-bin /usr/bin/composer /usr/local/bin/composer
WORKDIR /app
COPY . .
RUN composer install \
    --no-dev \
    --no-interaction \
    --no-progress \
    --prefer-dist \
    --classmap-authoritative \
    --no-scripts

FROM php-base AS runtime
ARG APP_VERSION=development
ARG VCS_REF=unknown
LABEL org.opencontainers.image.title="Providentia backend" \
      org.opencontainers.image.source="https://github.com/vast-development-method/providentia-laminas" \
      org.opencontainers.image.version="${APP_VERSION}" \
      org.opencontainers.image.revision="${VCS_REF}"
WORKDIR /app
COPY --from=dependencies /app /app
COPY infrastructure/php/production.ini /usr/local/etc/php/conf.d/zz-providentia-production.ini
RUN chmod +x bin/doctrine-migrations bin/providentia tool/*.sh \
    && mkdir -p var/cache var/log \
    && chown -R www-data:www-data var

USER www-data
EXPOSE 9000
CMD ["php-fpm", "-F"]

FROM runtime AS cli
CMD ["php", "bin/providentia", "list"]

FROM runtime AS media-worker
USER root
RUN apk add --no-cache ffmpeg
USER www-data
CMD ["php", "bin/providentia", "ai:video:process"]

FROM ${CADDY_IMAGE} AS web
COPY infrastructure/caddy/Caddyfile.production /etc/caddy/Caddyfile
COPY public /srv/public

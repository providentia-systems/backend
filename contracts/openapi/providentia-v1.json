{
  "openapi": "3.1.0",
  "info": {
    "title": "Providentia API",
    "version": "1.3.0",
    "summary": "Authoritative implemented Phase 2/4 increment contract",
    "description": "Bounded identity, multi-home tenancy, published global catalog reads, and home-scoped offline synchronization prototype."
  },
  "jsonSchemaDialect": "https://json-schema.org/draft/2020-12/schema",
  "servers": [{"url": "/"}],
  "security": [{"bearerAuth": []}, {"cookieAuth": []}],
  "paths": {
    "/health/live": {"get": {"operationId": "getLiveness", "security": [], "tags": ["Operations"], "responses": {"200": {"description": "Alive", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/HealthStatus"}}}}}}},
    "/health/ready": {"get": {"operationId": "getReadiness", "security": [], "tags": ["Operations"], "responses": {"200": {"description": "Ready", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/ReadinessStatus"}}}}, "503": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/system/info": {"get": {"operationId": "getSystemInfo", "security": [], "tags": ["System"], "responses": {"200": {"description": "Runtime information", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SystemInfo"}}}}}}},
    "/metrics": {"get": {"operationId": "getMetrics", "security": [], "tags": ["Operations"], "responses": {"200": {"description": "Prometheus exposition", "content": {"text/plain": {"schema": {"type": "string"}}}}}}},
    "/api/v1/auth/register": {
      "post": {
        "operationId": "registerAccount",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterRequest"}}}},
        "responses": {"202": {"description": "Generic accepted response whether the account is new or already exists", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/RegisterResponse"}}}}, "422": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "operationId": "verifyEmail",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenRequest"}}}},
        "responses": {"204": {"description": "Verified"}, "422": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/auth/verify-email/resend": {
      "post": {
        "operationId": "resendEmailVerification",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmailRequest"}}}},
        "responses": {"202": {"description": "Accepted without account enumeration"}}
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "operationId": "login",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/LoginRequest"}}}},
        "responses": {"200": {"description": "Native credentials or secure cookie session issued", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionCredentials"}}}}, "401": {"$ref": "#/components/responses/Problem"}, "429": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "operationId": "refreshSession",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"content": {"application/json": {"schema": {"type": "object", "properties": {"refreshToken": {"type": "string", "writeOnly": true}}}}}},
        "responses": {"200": {"description": "Rotated credentials", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SessionCredentials"}}}}, "401": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/auth/logout": {"post": {"operationId": "logout", "tags": ["Identity"], "responses": {"204": {"description": "Current session revoked and cookies cleared"}}}},
    "/api/v1/auth/password-reset/request": {
      "post": {
        "operationId": "requestPasswordReset",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/EmailRequest"}}}},
        "responses": {"202": {"description": "Accepted without account enumeration"}}
      }
    },
    "/api/v1/auth/password-reset/complete": {
      "post": {
        "operationId": "completePasswordReset",
        "security": [],
        "tags": ["Identity"],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["token", "password"], "properties": {"token": {"type": "string"}, "password": {"type": "string", "minLength": 12, "maxLength": 1024}}}}}},
        "responses": {"204": {"description": "Password changed and all sessions revoked"}, "422": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/auth/sessions": {"get": {"operationId": "listDeviceSessions", "tags": ["Identity"], "responses": {"200": {"description": "Device sessions without secret material", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/DeviceSession"}}}}}}}}}},
    "/api/v1/auth/sessions/{sessionId}": {"delete": {"operationId": "revokeDeviceSession", "tags": ["Identity"], "parameters": [{"$ref": "#/components/parameters/SessionId"}], "responses": {"204": {"description": "Revoked"}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/homes": {
      "get": {"operationId": "listHomes", "tags": ["Homes"], "responses": {"200": {"description": "Authorized homes", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/Home"}}}}}}}}},
      "post": {"operationId": "createHome", "tags": ["Homes"], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/CreateHomeRequest"}}}}, "responses": {"201": {"description": "Created", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Home"}}}}, "422": {"$ref": "#/components/responses/Problem"}}}
    },
    "/api/v1/homes/{homeId}": {"get": {"operationId": "getHome", "tags": ["Homes"], "parameters": [{"$ref": "#/components/parameters/HomeId"}], "responses": {"200": {"description": "Authorized home", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Home"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/homes/{homeId}/switch": {"post": {"operationId": "switchHome", "tags": ["Homes"], "parameters": [{"$ref": "#/components/parameters/HomeId"}], "responses": {"200": {"description": "Session active home changed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Home"}}}}, "404": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/homes/{homeId}/memberships": {"get": {"operationId": "listHomeMemberships", "tags": ["Homes"], "parameters": [{"$ref": "#/components/parameters/HomeId"}], "responses": {"200": {"description": "Memberships", "content": {"application/json": {"schema": {"type": "object", "required": ["data"], "properties": {"data": {"type": "array", "items": {"$ref": "#/components/schemas/HomeMembership"}}}}}}}}}},
    "/api/v1/homes/{homeId}/memberships/{userId}": {
      "patch": {
        "operationId": "changeHomeMembershipRole",
        "tags": ["Homes"],
        "parameters": [{"$ref": "#/components/parameters/HomeId"}, {"$ref": "#/components/parameters/UserId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["role", "expectedRevision"], "properties": {"role": {"$ref": "#/components/schemas/HomeRole"}, "expectedRevision": {"type": "integer", "minimum": 1}}}}}},
        "responses": {"204": {"description": "Role changed"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/homes/{homeId}/memberships/me": {"delete": {"operationId": "leaveHome", "tags": ["Homes"], "parameters": [{"$ref": "#/components/parameters/HomeId"}], "responses": {"204": {"description": "Left"}, "409": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/homes/{homeId}/ownership-transfer": {
      "post": {
        "operationId": "transferHomeOwnership",
        "tags": ["Homes"],
        "parameters": [{"$ref": "#/components/parameters/HomeId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["targetUserId", "expectedTargetRevision"], "properties": {"targetUserId": {"type": "string", "format": "uuid"}, "expectedTargetRevision": {"type": "integer", "minimum": 1}}}}}},
        "responses": {"204": {"description": "Ownership atomically transferred"}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/homes/{homeId}/invitations": {
      "post": {
        "operationId": "createHomeInvitation",
        "tags": ["Homes"],
        "parameters": [{"$ref": "#/components/parameters/HomeId"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"type": "object", "additionalProperties": false, "required": ["email", "role"], "properties": {"email": {"type": "string", "format": "email"}, "role": {"type": "string", "enum": ["manager", "member", "viewer"]}}}}}},
        "responses": {"201": {"description": "Expiring single-use invitation created and mailed", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/InvitationCreated"}}}}, "403": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/home-invitations/accept": {"post": {"operationId": "acceptHomeInvitation", "tags": ["Homes"], "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/TokenRequest"}}}}, "responses": {"200": {"description": "Accepted", "content": {"application/json": {"schema": {"type": "object"}}}}, "422": {"$ref": "#/components/responses/Problem"}}}},
    "/api/v1/catalog/products": {
      "get": {
        "operationId": "searchCatalogProducts",
        "security": [],
        "tags": ["Catalog"],
        "parameters": [{"name": "q", "in": "query", "schema": {"type": "string", "maxLength": 191}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 100, "default": 50}}, {"name": "offset", "in": "query", "schema": {"type": "integer", "minimum": 0, "default": 0}}],
        "responses": {"200": {"description": "Published global catalog only", "content": {"application/json": {"schema": {"type": "object"}}}}}
      }
    },
    "/api/v1/homes/{homeId}/sync/push": {
      "post": {
        "operationId": "pushHomeSynchronization",
        "tags": ["Synchronization"],
        "parameters": [{"$ref": "#/components/parameters/HomeId"}, {"$ref": "#/components/parameters/IdempotencyKey"}],
        "requestBody": {"required": true, "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SyncPushRequest"}}}},
        "responses": {"200": {"description": "One classified result per operation", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SyncPushResponse"}}}}, "403": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/homes/{homeId}/sync/pull": {
      "get": {
        "operationId": "pullHomeSynchronization",
        "tags": ["Synchronization"],
        "parameters": [{"$ref": "#/components/parameters/HomeId"}, {"name": "cursor", "in": "query", "schema": {"type": "string"}}, {"name": "limit", "in": "query", "schema": {"type": "integer", "minimum": 1, "maximum": 250, "default": 250}}],
        "responses": {"200": {"description": "Ordered changes through a frozen high-water cursor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SyncPullResponse"}}}}, "410": {"$ref": "#/components/responses/Problem"}}
      }
    },
    "/api/v1/homes/{homeId}/sync/bootstrap": {
      "get": {
        "operationId": "bootstrapHomeSynchronization",
        "tags": ["Synchronization"],
        "parameters": [{"$ref": "#/components/parameters/HomeId"}],
        "responses": {"200": {"description": "Consistent authorized current-state snapshot and captured cursor", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/SyncBootstrapResponse"}}}}, "409": {"$ref": "#/components/responses/Problem"}}
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {"type": "http", "scheme": "bearer", "bearerFormat": "opaque"},
      "cookieAuth": {"type": "apiKey", "in": "cookie", "name": "providentia_access"}
    },
    "parameters": {
      "HomeId": {"name": "homeId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "UserId": {"name": "userId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "SessionId": {"name": "sessionId", "in": "path", "required": true, "schema": {"type": "string", "format": "uuid"}},
      "IdempotencyKey": {"name": "Idempotency-Key", "in": "header", "required": true, "description": "Must equal batchId for stable identical batch retries.", "schema": {"type": "string", "format": "uuid"}}
    },
    "responses": {
      "Problem": {"description": "RFC 9457 Problem Details", "content": {"application/problem+json": {"schema": {"$ref": "#/components/schemas/ProblemDetails"}}}}
    },
    "schemas": {
      "ProblemDetails": {"type": "object", "description": "Problem Details for HTTP APIs as defined by RFC 9457.", "required": ["type", "title", "status", "requestId"], "properties": {"type": {"type": "string"}, "title": {"type": "string"}, "status": {"type": "integer", "minimum": 400, "maximum": 599}, "detail": {"type": "string"}, "requestId": {"type": "string"}}, "additionalProperties": true},
      "HealthStatus": {"type": "object", "required": ["status", "timestamp"], "properties": {"status": {"const": "alive"}, "timestamp": {"type": "string", "format": "date-time"}}},
      "ReadinessStatus": {"type": "object", "required": ["status", "checks"], "properties": {"status": {"enum": ["ready", "not_ready"]}, "checks": {"type": "object"}}},
      "SystemInfo": {"type": "object", "required": ["product", "apiVersion", "applicationVersion", "environment", "runtime", "databaseDriver", "queueAdapter", "queueBroker"], "properties": {"product": {"const": "Providentia"}, "apiVersion": {"const": "v1"}, "applicationVersion": {"type": "string"}, "environment": {"type": "string"}, "runtime": {"type": "string"}, "databaseDriver": {"type": "string"}, "queueAdapter": {"const": "enqueue-redis"}, "queueBroker": {"enum": ["redis-compatible", "unknown"]}}},
      "RegisterRequest": {"type": "object", "additionalProperties": false, "required": ["email", "password", "displayName"], "properties": {"email": {"type": "string", "format": "email"}, "password": {"type": "string", "minLength": 12, "maxLength": 1024}, "displayName": {"type": "string", "minLength": 1, "maxLength": 120}, "locale": {"type": "string"}, "timezone": {"type": "string"}}},
      "RegisterResponse": {"type": "object", "additionalProperties": false, "required": ["accepted", "verificationRequired"], "properties": {"accepted": {"const": true}, "verificationRequired": {"const": true}, "developmentVerificationToken": {"type": "string", "writeOnly": true, "description": "Present only in an explicitly enabled non-production development profile."}}},
      "EmailRequest": {"type": "object", "additionalProperties": false, "required": ["email"], "properties": {"email": {"type": "string", "format": "email"}}},
      "TokenRequest": {"type": "object", "additionalProperties": false, "required": ["token"], "properties": {"token": {"type": "string", "minLength": 40}}},
      "LoginRequest": {"type": "object", "additionalProperties": false, "required": ["email", "password", "deviceId", "deviceName", "platform"], "properties": {"email": {"type": "string", "format": "email"}, "password": {"type": "string"}, "deviceId": {"type": "string", "format": "uuid"}, "deviceName": {"type": "string"}, "platform": {"type": "string"}, "transport": {"enum": ["native", "web"], "default": "native"}}},
      "SessionCredentials": {"type": "object", "required": ["sessionId", "deviceId", "accessExpiresAt"], "properties": {"accessToken": {"type": "string", "writeOnly": true}, "refreshToken": {"type": "string", "writeOnly": true}, "csrfToken": {"type": "string", "writeOnly": true}, "sessionId": {"type": "string", "format": "uuid"}, "deviceId": {"type": "string", "format": "uuid"}, "accessExpiresAt": {"type": "string", "format": "date-time"}, "transport": {"type": "string"}}},
      "DeviceSession": {"type": "object", "required": ["id", "deviceId"], "properties": {"id": {"type": "string", "format": "uuid"}, "deviceId": {"type": "string", "format": "uuid"}, "deviceName": {"type": "string"}, "platform": {"type": "string"}, "activeHomeId": {"type": ["string", "null"], "format": "uuid"}, "createdAt": {"type": "string"}, "lastSeenAt": {"type": "string"}, "revokedAt": {"type": ["string", "null"]}}},
      "HomeRole": {"type": "string", "enum": ["owner", "manager", "member", "viewer"]},
      "CreateHomeRequest": {"type": "object", "additionalProperties": false, "required": ["name"], "properties": {"name": {"type": "string", "minLength": 1, "maxLength": 120}, "locale": {"type": "string", "default": "en-NA"}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$", "default": "NAD"}, "timezone": {"type": "string", "default": "Africa/Windhoek"}}},
      "Home": {"type": "object", "required": ["id", "name", "revision"], "properties": {"id": {"type": "string", "format": "uuid"}, "name": {"type": "string"}, "defaultLocale": {"type": "string"}, "defaultCurrency": {"type": "string"}, "defaultTimezone": {"type": "string"}, "role": {"$ref": "#/components/schemas/HomeRole"}, "revision": {"type": "integer"}}},
      "HomeMembership": {"type": "object", "required": ["userId", "role", "revision"], "properties": {"userId": {"type": "string", "format": "uuid"}, "displayName": {"type": "string"}, "role": {"$ref": "#/components/schemas/HomeRole"}, "revision": {"type": "integer"}}},
      "InvitationCreated": {"type": "object", "additionalProperties": false, "required": ["invitationId", "expiresAt", "delivery"], "properties": {"invitationId": {"type": "string", "format": "uuid"}, "expiresAt": {"type": "string", "format": "date-time"}, "delivery": {"const": "transactional-email"}}},
      "SyncPrivateNotePayload": {"type": "object", "additionalProperties": false, "required": ["body"], "properties": {"title": {"type": "string", "maxLength": 120}, "body": {"type": "string", "minLength": 1, "maxLength": 4000}}},
      "SyncHomePreferencePayload": {"type": "object", "additionalProperties": false, "minProperties": 1, "properties": {"defaultLocale": {"type": "string", "pattern": "^[a-z]{2,3}(?:-[A-Z]{2})?$"}, "defaultCurrency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "defaultTimezone": {"type": "string", "minLength": 1, "maxLength": 64}, "measurementSystem": {"enum": ["metric", "imperial"]}}},
      "SyncOperation": {
        "type": "object",
        "additionalProperties": false,
        "required": ["operationId", "entityType", "entityId", "operationType", "clientTimestamp", "payloadSchemaVersion", "payload"],
        "properties": {
          "operationId": {"type": "string", "format": "uuid"},
          "entityType": {"enum": ["home-preference", "private-note"]},
          "entityId": {"type": "string", "format": "uuid"},
          "operationType": {"enum": ["put", "delete"]},
          "baseRevision": {"type": ["integer", "null"], "minimum": 0},
          "clientTimestamp": {"type": "string", "format": "date-time"},
          "payloadSchemaVersion": {"const": 1},
          "payload": {"type": "object"}
        },
        "allOf": [
          {"if": {"properties": {"operationType": {"const": "delete"}}, "required": ["operationType"]}, "then": {"properties": {"payload": {"type": "object", "maxProperties": 0}}}},
          {"if": {"properties": {"operationType": {"const": "put"}, "entityType": {"const": "private-note"}}, "required": ["operationType", "entityType"]}, "then": {"properties": {"payload": {"$ref": "#/components/schemas/SyncPrivateNotePayload"}}}},
          {"if": {"properties": {"operationType": {"const": "put"}, "entityType": {"const": "home-preference"}}, "required": ["operationType", "entityType"]}, "then": {"properties": {"payload": {"$ref": "#/components/schemas/SyncHomePreferencePayload"}}}}
        ]
      },
      "SyncPushRequest": {"type": "object", "additionalProperties": false, "required": ["protocolVersion", "batchId", "deviceId", "operations"], "properties": {"protocolVersion": {"const": 1}, "batchId": {"type": "string", "format": "uuid"}, "deviceId": {"type": "string", "format": "uuid"}, "lastPulledCursor": {"type": ["string", "null"]}, "operations": {"type": "array", "minItems": 1, "maxItems": 100, "items": {"$ref": "#/components/schemas/SyncOperation"}}}},
      "SyncOperationResult": {"type": "object", "required": ["operationId", "status"], "properties": {"operationId": {"type": "string", "format": "uuid"}, "status": {"enum": ["accepted", "conflict", "validation_error", "authorization_failure", "retryable_failure"]}, "entityType": {"type": "string"}, "entityId": {"type": "string", "format": "uuid"}, "revision": {"type": "integer"}, "changeCursor": {"type": "string"}, "representation": {"type": "object"}, "conflict": {"type": "object"}, "detail": {"type": "string"}}},
      "SyncPushResponse": {"type": "object", "required": ["protocolVersion", "batchId", "requestId", "serverTime", "results", "highWaterCursor"], "properties": {"protocolVersion": {"const": 1}, "batchId": {"type": "string", "format": "uuid"}, "requestId": {"type": "string"}, "serverTime": {"type": "string", "format": "date-time"}, "results": {"type": "array", "items": {"$ref": "#/components/schemas/SyncOperationResult"}}, "highWaterCursor": {"type": "string"}}},
      "SyncChange": {"type": "object", "required": ["cursor", "entityType", "entityId", "operation", "revision", "serverTimestamp", "representationSchemaVersion"], "properties": {"cursor": {"type": "string"}, "entityType": {"type": "string"}, "entityId": {"type": "string", "format": "uuid"}, "operation": {"enum": ["upsert", "delete"]}, "revision": {"type": "integer"}, "serverTimestamp": {"type": "string", "format": "date-time"}, "representationSchemaVersion": {"const": 1}, "representation": {"type": "object"}, "tombstone": {"type": "object", "required": ["deletedAt"], "properties": {"deletedAt": {"type": "string", "format": "date-time"}}}}},
      "SyncPullResponse": {"type": "object", "required": ["protocolVersion", "requestId", "fromCursor", "pageCursor", "highWaterCursor", "hasMore", "changes"], "properties": {"protocolVersion": {"const": 1}, "requestId": {"type": "string"}, "fromCursor": {"type": "string"}, "pageCursor": {"type": "string"}, "highWaterCursor": {"type": "string"}, "hasMore": {"type": "boolean"}, "changes": {"type": "array", "items": {"$ref": "#/components/schemas/SyncChange"}}}}
      ,
      "SyncBootstrapResponse": {"type": "object", "required": ["protocolVersion", "requestId", "snapshotCursor", "records"], "properties": {"protocolVersion": {"const": 1}, "requestId": {"type": "string"}, "snapshotCursor": {"type": "string"}, "records": {"type": "array", "maxItems": 250, "items": {"type": "object"}}}}
    }
  },
  "tags": [{"name": "Operations"}, {"name": "System"}, {"name": "Identity"}, {"name": "Homes"}, {"name": "Catalog"}, {"name": "Synchronization"}]
}

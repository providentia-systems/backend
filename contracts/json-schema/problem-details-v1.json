{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://providentia.invalid/schemas/problem-details-v1.json",
  "title": "ProblemDetails",
  "description": "RFC 9457 compatible problem response with Providentia request correlation.",
  "type": "object",
  "required": [
    "type",
    "title",
    "status",
    "requestId"
  ],
  "properties": {
    "type": {
      "type": "string",
      "format": "uri-reference"
    },
    "title": {
      "type": "string"
    },
    "status": {
      "type": "integer",
      "minimum": 400,
      "maximum": 599
    },
    "detail": {
      "type": "string"
    },
    "instance": {
      "type": "string",
      "format": "uri-reference"
    },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  },
  "additionalProperties": true
}


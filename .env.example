APP_ENV=development
APP_VERSION=0.1.0
APP_DEBUG=1
# Permanent client distribution identifier: com.vastdevelopmentmethod.providentia
DATABASE_URL=sqlite:///var/providentia.sqlite
QUEUE_DSN=redis+phpredis://redis:6379
QUEUE_NAME=providentia.default
QUEUE_REQUIRED=0
OUTBOX_BATCH_SIZE=100
OUTBOX_MAX_ATTEMPTS=10
AUTH_ACCESS_TTL_SECONDS=900
AUTH_REFRESH_TTL_SECONDS=2592000
# 0 keeps trusted installations signed in until explicit sign-out, device or
# session revocation, account disablement, or a security invalidation. Set a
# positive number of seconds only as a deliberate finite inactivity ceiling.
AUTH_WEB_IDLE_TTL_SECONDS=0
AUTH_NATIVE_IDLE_TTL_SECONDS=0
AUTH_LOGIN_LINK_TTL_SECONDS=900
AUTH_LOGIN_LINK_EXCHANGE_TTL_SECONDS=120
AUTH_LOGIN_LINK_POLL_INTERVAL_SECONDS=3
AUTH_LOGIN_LINK_RETENTION_DAYS=30
AUTH_RATE_LIMIT_RETENTION_DAYS=2
AUTH_TOKEN_PEPPER=replace-with-a-secret-from-your-secret-manager
AUTH_COOKIE_SECURE=0
PLATFORM_BOOTSTRAP_ADMIN_EMAILS=
ONBOARDING_HOME_NAME=My home
ONBOARDING_HOME_LOCALE=en-NA
ONBOARDING_HOME_CURRENCY=NAD
ONBOARDING_HOME_TIMEZONE=Africa/Windhoek
SYNC_CURSOR_SECRET=replace-with-an-independent-secret-from-your-secret-manager
SYNC_CURSOR_TTL_SECONDS=2592000
SYNC_OFFLINE_WINDOW_DAYS=90
SYNC_TOMBSTONE_RETENTION_DAYS=120
EXPOSE_DEVELOPMENT_TOKENS=0
MAIL_DSN=smtp://mailpit:1025
MAIL_FROM=no-reply@providentia.local
# Browser login approvals use this backend origin. App links below remain for
# application-owned step-up confirmations.
PUBLIC_BASE_URL=http://127.0.0.1:8080
HOMEOWNER_APP_LINK_BASE=providentia://login-link/homeowner
ADMIN_APP_LINK_BASE=providentia-admin://login-link/admin
AUTH_APP_LINK_ALLOWED_HOSTS=login-link
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000,http://127.0.0.1:8081,http://localhost:8081
AI_SERVER_PROXY_ENABLED=0
AI_CREDENTIAL_KEK=
AI_CREDENTIAL_KEY_VERSION=1
AI_ORCHESTRATION_MAX_ATTEMPTS=8
AI_COMPATIBLE_ENDPOINT=
AI_OLLAMA_ENDPOINT=
AI_ALLOW_PRIVATE_ENDPOINTS=0
# Deliberately separate LAN policy for person/home-owned profile endpoints:
# 1 lets an Ollama profile endpoint use plain HTTP and private/loopback hosts.
# Every other profile endpoint stays HTTPS with a public host.
AI_ALLOW_PRIVATE_NETWORK_ENDPOINTS=0
AI_MAX_IMAGE_BYTES=8388608
AI_MAX_IMAGES=8
AI_MEDIA_ROOT=var/private-media
AI_MEDIA_KEK=
CATALOG_IMAGE_KEK=
CATALOG_IMAGE_KEY_VERSION=1
CATALOG_IMAGE_PREVIOUS_KEYS_JSON=[]
AI_MEDIA_KEY_VERSION=1
AI_MEDIA_DEFAULT_QUOTA_BYTES=2147483648
AI_MEDIA_TRANSIENT_TTL_SECONDS=86400
AI_MEDIA_MAX_EXPORT_BYTES=67108864
AI_MAX_VIDEO_BYTES=134217728
AI_MAX_VIDEO_DURATION_SECONDS=300
AI_MAX_VIDEO_FRAMES=12
AI_VIDEO_PROCESS_TIMEOUT_SECONDS=180
AI_FFPROBE_BINARY=/usr/bin/ffprobe
AI_FFMPEG_BINARY=/usr/bin/ffmpeg
BILLING_ENABLED=0
BILLING_ALLOW_PRIVATE_ENDPOINTS=0
BILLING_HTTP_TIMEOUT_SECONDS=10
BILLING_MAXIMUM_RESPONSE_BYTES=1048576
PAYPAL_ENABLED=0
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
HOSTED_CARD_ENABLED=0
HOSTED_CARD_API_BASE=
HOSTED_CARD_CHECKOUT_PATH=/v1/checkout/sessions
HOSTED_CARD_REDIRECT_HOSTS=
HOSTED_CARD_API_KEY=
HOSTED_CARD_WEBHOOK_SECRET=
HOSTED_CARD_WEBHOOK_SIGNATURE_HEADER=X-Webhook-Signature
HOSTED_CARD_WEBHOOK_TIMESTAMP_HEADER=X-Webhook-Timestamp
HOSTED_CARD_WEBHOOK_TOLERANCE_SECONDS=300
DATA_EXPORT_KEK=
DATA_EXPORT_ROOT=var/data-exports
DATA_EXPORT_PAGE_SIZE=250

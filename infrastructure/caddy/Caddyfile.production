{
    auto_https off
    admin off
    persist_config off
    servers {
        trusted_proxies static {$PROVIDENTIA_TRUSTED_PROXY_CIDRS}
        trusted_proxies_strict
        client_ip_headers X-Forwarded-For X-Real-IP
    }
}

:8080 {
    root * /srv/public
    encode zstd gzip

    @blocked {
        path /.env* /.git/* /composer.* /config/* /src/* /vendor/*
    }
    respond @blocked 404

    @operational path /metrics
    respond @operational 404

    request_body {
        max_size 160MB
    }

    @static path /assets/*
    header @static Cache-Control "public, max-age=31536000, immutable"
    file_server @static

    @php path /*
    php_fastcgi @php api:9000 {
        root /app/public
        capture_stderr
    }

    header {
        -Server
        ?X-Content-Type-Options "nosniff"
        ?Referrer-Policy "no-referrer"
        ?Permissions-Policy "camera=(), microphone=(), geolocation=()"
        ?Content-Security-Policy "default-src 'self'; object-src 'none'; base-uri 'none'; frame-ancestors 'none'"
    }

    log {
        output stdout
        format filter {
            request>uri regexp \\?.*$ ?REDACTED
            wrap json
        }
    }
}

# Backend-network-only scrape listener. Compose does not publish this port to
# the host, and Caddy requires an independent deployment secret before proxying
# the otherwise public application metric handler.
:9090 {
    @metrics {
        path /metrics
        header Authorization "Bearer {$PROVIDENTIA_METRICS_TOKEN}"
    }
    php_fastcgi @metrics api:9000 {
        root /app/public
        capture_stderr
    }
    respond 404

    log {
        output stdout
        format json
    }
}

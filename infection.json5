{
  "$schema": "./vendor/infection/infection/resources/schema.json",
  "timeout": 20,
  "source": {
    "directories": [
      "src/Inventory/Domain",
      "src/Shopping/Domain",
      "src/Synchronization/Application/Command",
      "src/AiIntegration/Application/Orchestration",
      "src/Billing/Domain",
      "src/DataGovernance/Domain"
    ]
  },
  "logs": {
    "text": "var/infection.log",
    "summary": "var/infection-summary.log",
    "json": "var/infection.json"
  },
  "mutators": {
    "@default": true
  },
  "testFramework": "phpunit",
  "testFrameworkOptions": "--testsuite=Providentia"
}

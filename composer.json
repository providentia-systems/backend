{
  "name": "vast-development-method/providentia-laminas",
  "description": "Providentia modular Mezzio and Laminas backend",
  "type": "project",
  "require": {
    "php": "~8.5.0",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-pdo": "*",
    "ext-redis": "*",
    "doctrine/dbal": "4.4.4",
    "doctrine/migrations": "3.9.5",
    "doctrine/orm": "3.6.6",
    "enqueue/enqueue": "0.10.26",
    "enqueue/redis": "0.10.26",
    "laminas/laminas-cli": "1.15.0",
    "laminas/laminas-config-aggregator": "1.20.0",
    "laminas/laminas-diactoros": "3.8.0",
    "laminas/laminas-servicemanager": "4.5.1",
    "laminas/laminas-view": "3.1.0",
    "mezzio/mezzio": "3.28.1",
    "mezzio/mezzio-fastroute": "3.14.0",
    "mezzio/mezzio-helpers": "5.20.0",
    "mezzio/mezzio-problem-details": "1.15.0",
    "mezzio/mezzio-laminasviewrenderer": "3.1.0",
    "mezzio/mezzio-template": "3.0.0",
    "psr/clock": "1.0.0",
    "psr/container": "2.0.2",
    "psr/http-message": "2.0",
    "psr/log": "3.0.2",
    "ramsey/uuid": "4.9.1"
  },
  "require-dev": {
    "ergebnis/composer-normalize": "2.48.2",
    "infection/infection": "0.31.5",
    "maglnet/composer-require-checker": "4.17.0",
    "phpstan/phpstan": "2.1.32",
    "phpunit/phpunit": "12.3.4",
    "roave/security-advisories": "dev-latest",
    "squizlabs/php_codesniffer": "4.0.1"
  },
  "autoload": {
    "psr-4": {
      "Providentia\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ProvidentiaTest\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "ergebnis/composer-normalize": true,
      "infection/extension-installer": false
    },
    "platform": {
      "php": "8.5.8"
    },
    "preferred-install": {
      "*": "dist"
    },
    "sort-packages": true
  },
  "scripts": {
    "check": [
      "@validate",
      "@cs",
      "@static",
      "@test",
      "@architecture",
      "@contract"
    ],
    "validate": "composer validate --strict --no-check-publish",
    "cs": "phpcs",
    "cs:fix": "phpcbf",
    "static": "phpstan analyse --no-progress --memory-limit=512M",
    "test": "phpunit --colors=always",
    "architecture": "php tests/Architecture/verify.php",
    "contract": "php tests/Contract/verify-openapi.php",
    "migrate": "php bin/doctrine-migrations migrations:migrate --no-interaction",
    "migrate:status": "php bin/doctrine-migrations migrations:status",
    "serve": "php -S 127.0.0.1:8080 -t public public/index.php",
    "worker": "php bin/providentia queue:consume",
    "outbox": "php bin/providentia outbox:relay --once"
  }
}
